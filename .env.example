# Leng backend configuration.
# Copy this file to .env and fill in the required values.
# The docker-compose service maps the backend to ${LENG_PORT:-28080} and
# mounts ${LENG_DATA_DIR:-./data} at /data; LENG_DB_PATH is overridden
# to /data/leng.db by compose, so the value below matters only for
# non-docker (local uv) runs.

# Required: token checked in the X-Api-Token header of every /v1 route.
LENG_API_TOKEN=

# Required: SQLite file path.
LENG_DB_PATH=

# Required: OpenAI-compatible LLM base URL; the client appends /v1/chat/completions.
LENG_LLM_BASE_URL=

# Optional: LLM model name reported in the completion request.
#LENG_LLM_MODEL=glm5.3-flash:claude

# Required: API key sent as the Bearer token to the LLM.
LENG_LLM_API_KEY=

# Optional: LLM request timeout in seconds.
#LENG_LLM_TIMEOUT_S=10.0

# Optional: host port for the backend service.
#LENG_PORT=28080

# Optional: host directory mounted at /data in the backend container.
#LENG_DATA_DIR=./data

# Reserved for MVP-3 (Telegram bot); unused by the MVP-1 backend.
#TELEGRAM_BOT_TOKEN=
