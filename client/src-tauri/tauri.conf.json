{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leng",
  "version": "0.1.0",
  "identifier": "app.leng.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER — вписать настоящий minisign-публичный ключ после генерации (см. docs/cicd-setup.md); до этого update-проверка падает тихо, клиент работает"
    }
  }
}
